{
  "functions": {
    "api/*.php": { "runtime": "vercel-php@0.9.0" },
    "api/pemain/*.php": { "runtime": "vercel-php@0.9.0" },
    "api/pertandingan/*.php": { "runtime": "vercel-php@0.9.0" }
  },
  "routes": [
    { "src": "/(?:.*/)?assets/(.*)", "dest": "/api/asset.php?f=$1" },
    { "src": "/", "dest": "/api/index.php" },
    { "src": "/(.*)", "dest": "/api/$1" }
  ]
}
