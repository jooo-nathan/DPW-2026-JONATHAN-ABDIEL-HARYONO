{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/assets/css/(.*)",
      "dest": "/api/assets/css/$1"
    },
    {
      "src": "/assets/js/(.*)",
      "dest": "/api/assets/js/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}